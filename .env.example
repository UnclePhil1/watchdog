# ── BSC RPC endpoint ─────────────────────────────────────────────────────
# Use a reliable public or paid RPC provider (Ankr, QuickNode, Blast API,
# NodeReal, or the official BSC dataseed). Never commit real keys.
#
# WebSocket is preferred for lower-latency block notifications; HTTP is
# used as the base connection and as a fallback if the WSS URL fails to
# connect at startup. Set at least one of the two.
BSC_RPC_WSS=wss://bsc-rpc.publicnode.com
BSC_RPC_HTTP=https://bsc-dataseed.binance.org

# ── Telegram ─────────────────────────────────────────────────────────────
# Create a bot with @BotFather on Telegram to get a token, then message
# your bot (or add it to a group) and use @userinfobot / getUpdates to
# find the numeric chat id. See README.md for step-by-step instructions.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=123456789

# ── Wallet to monitor ────────────────────────────────────────────────────
# Defaults to the address below if left unset.
SOURCE_WALLET=0xa81697d866bFCfbDecd44134c5c02c7032c07777

# ── Tuning (all optional, sensible defaults applied if unset) ───────────
# How often to poll for new blocks, in seconds.
POLL_INTERVAL_SECONDS=4
# Number of blocks to stay behind chain head before processing, as a
# shallow-reorg safety margin.
CONFIRMATIONS=3
# How many blocks after a watched wallet deploys a contract to still
# treat a later PancakeSwap V2 PairCreated event as that same launch.
LAUNCH_LOOKBACK_BLOCKS=200
# Max blocks processed per get_logs call / loop iteration when catching
# up (tune down if your RPC provider caps eth_getLogs block ranges).
MAX_BLOCK_BATCH=200
# Leave unset to start from the current chain head on first run (no
# history backfill). Set to a specific block number to backfill from there.
START_BLOCK=
# Where to persist state (SQLite file).
DB_PATH=watchdog.db
LOG_LEVEL=INFO
